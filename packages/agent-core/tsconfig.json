{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/test-*.ts",
    "src/tools/test-*.ts",
    "src/tools/list-*.ts",
    "src/tools/mcp/test-*.ts",
    "src/tools/mcp/inspect-*.ts"
  ]
}
