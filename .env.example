PARALLAX_API_URL=http://localhost:8000

# Local UI preview only. Keep both false when validating production authentication.
PARALLAX_DISABLE_AUTH=false
PARALLAX_DISABLE_RBAC=false

# Optional: use a real development session while the login UI is disabled.
# PARALLAX_DEV_ACCESS_TOKEN=
# PARALLAX_DEV_WORKSPACE_ID=

# Temporary local preview bypass. Never enable these in a shared or production environment.
PARALLAX_DISABLE_AUTH=false
PARALLAX_DISABLE_RBAC=false

# Optional: keep real protected API data available while the frontend login UI is bypassed.
# PARALLAX_DEV_ACCESS_TOKEN=
# PARALLAX_DEV_WORKSPACE_ID=
