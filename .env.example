# Parallax backend environment — placeholder values only.
# Copy to .env and fill in real credentials. Never commit .env.

# Core
APP_ENV=local
API_PORT=8000
LOG_LEVEL=INFO

# Database (Postgres for production-like, SQLite for the fastest demo).
# SQLite requires the async driver:
DATABASE_URL=sqlite+aiosqlite:///./parallax.db
# DATABASE_URL=postgresql+asyncpg://parallax:parallax@localhost:5432/parallax

# Redis (required by the worker/outbox path)
REDIS_URL=redis://localhost:6379/0

# Auth (change before sharing)
JWT_SECRET=change-this-local-secret-before-sharing-123456

# Integration mode: mock | real
INTEGRATION_MODE=mock
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT=
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Agent Core service (must match the agent-core port)
AGENT_MODE=service
AGENT_SERVICE_URL=http://localhost:4010
AGENT_SERVICE_API_KEY=

# Webhook receiver (leave empty to keep /api/webhooks open locally)
WEBHOOK_SECRET=

# Optional demo failure injection for the durable-runtime demo:
# demo_failure_provider=jira|slack|notion
DEMO_FAILURE_PROVIDER=
